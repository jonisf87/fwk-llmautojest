{
  "name": "fwk-llmautojest",
  "version": "1.0.0",
  "description": "LLM-as-a-Judge integration testing framework with Jest. Provider-agnostic, runs with any OpenAI-compatible API. Workshop & interview reference.",
  "main": "index.js",
  "scripts": {
    "test": "NODE_ENV=test dotenv -e environments/local.env -- jest --silent=false",
    "test:ci": "NODE_ENV=test dotenv -e environments/local.env -- jest --silent=false --testPathPatterns=\"structural|semantic\"",
    "test:eval": "NODE_ENV=test dotenv -e environments/local.env -- jest --silent=false --testPathPatterns=\"eval\"",
    "test:debug": "NODE_ENV=test dotenv -e environments/local.env -- node --inspect=0.0.0.0:9238 node_modules/.bin/jest --runInBand --silent=false",
    "lint": "eslint --max-warnings 0 \"src/**/*.ts\"",
    "lint:fix": "eslint --fix --max-warnings 0 \"src/**/*.ts\"",
    "test:unit": "jest --silent=false --testPathPatterns=\"src/tests/unit\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "llm",
    "llm-as-judge",
    "integration-testing",
    "jest",
    "ai-evaluation",
    "openai",
    "anthropic",
    "gemini"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "jest-matcher-utils": "^30.5.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^18.0.9",
    "openai": "^7.43.0",
    "uuid": "^14.0.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
